{
  "name": "@critik/simple-webdriver",
  "version": "0.4.0-dev1",
  "description": "Javascript webdriver bindings with no dependency",
  "keywords": [
    "webdriver",
    "automation",
    "browser"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "prepublishOnly": "tsc",
    "test": "c8 --reporter=lcov --reporter=text mocha --retry 1 --timeout 3000 --import=tsx/esm 'test/unit/*test.ts'",
    "test-wd-chrome": "NOCK_OFF=true mocha --retries 2 --grep '^.*Chrome(?!.*Nock Only).*$' --timeout 30000 --import=tsx/esm 'test/unit/*test.ts'",
    "test-wd-safari": "NOCK_OFF=true mocha --retries 2 --grep '^.*Safari(?!.*Nock Only).*$' --timeout 30000 --import=tsx/esm 'test/unit/*test.ts'",
    "test-wd-edge": "NOCK_OFF=true mocha --retries 2 --grep '^.*Edge(?!.*Nock Only).*$' --timeout 30000 --import=tsx/esm 'test/unit/*test.ts'",
    "test-wd-firefox": "NOCK_OFF=true mocha --retries 2 --grep '^.*Firefox(?!.*Nock Only).*$' --timeout 30000 --import=tsx/esm 'test/unit/*test.ts'",
    "coverage": "c8 report --reporter=text-lcov | coveralls",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simonradier/simple-webdriver.git"
  },
  "author": "Simon RADIER",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/simonradier/simple-webdriver/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "homepage": "https://github.com/simonradier/simple-webdriver#readme",
  "devDependencies": {
    "@types/chai": "^5.2.2",
    "@types/chai-as-promised": "^8.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "c8": "^11.0.0",
    "chai": "^6.2.2",
    "chai-as-promised": "^8.0.1",
    "chromedriver": "^147.0.2",
    "coveralls": "^3.1.1",
    "eslint": "^10.2.0",
    "globals": "^17.5.0",
    "mocha": "^11.2.2",
    "nock": "^14.0.4",
    "prettier": "^3.5.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.0"
  }
}
