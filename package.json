{
  "name": "@critik/simple-webdriver",
  "version": "0.3.0",
  "description": "Javascript webdriver bindings with no dependency",
  "keywords": [
    "webdriver",
    "automation",
    "browser"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "prepublishOnly": "tsc",
    "test": "c8 --reporter=lcov --reporter=text mocha --retry 1 --timeout 3000 'test/unit/*test.ts'",
    "test-wd-chrome": "NOCK_OFF=true mocha --retries 2 --grep '^.*Chrome(?!.*Nock Only).*$' --timeout 30000 'test/unit/*test.ts'",
    "test-wd-safari": "NOCK_OFF=true mocha --retries 2 --grep '^.*Safari(?!.*Nock Only).*$' --timeout 30000 'test/unit/*test.ts'",
    "test-wd-edge": "NOCK_OFF=true mocha --retries 2 --grep '^.*Edge(?!.*Nock Only).*$' --timeout 30000 'test/unit/*test.ts'",
    "test-wd-firefox": "NOCK_OFF=true mocha --retries 2 --grep '^.*Firefox(?!.*Nock Only).*$' --timeout 30000 'test/unit/*test.ts'",
    "coverage": "c8 report --reporter=text-lcov | coveralls",
    "lint": "eslint src/",
    "format": "prettier --write ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simonradier/simple-webdriver.git"
  },
  "author": "Simon RADIER",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/simonradier/simple-webdriver/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "homepage": "https://github.com/simonradier/simple-webdriver#readme",
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "c8": "^10.0.0",
    "chai": "^5.1.2",
    "chai-as-promised": "^8.0.1",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "mocha": "^11.0.0",
    "nock": "^14.0.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0"
  }
}
